#!/bin/bash
# Voice guard: while ~/.voicemode/dnd or ~/.voicemode/away exists, hold VoiceMode's mic lock
# (the "conch") so no Claude Code session can start a voice turn — no speech,
# no listening chime, no mic recording — even sessions that don't know the
# CLAUDE.md rules. The lock's agent name is what blocked sessions are told, so
# it carries the instruction to queue the message in the inbox instead.
# Releases the lock when the user is present again.
# Runs forever under launchd (com.voicemode.dnd-guard).
exec "$HOME/.local/share/uv/tools/voice-mode/bin/python" -I - "$@" <<'PY'
import os, signal, sys, time
from datetime import datetime
from voice_mode.conch import Conch

DND = os.path.expanduser("~/.voicemode/dnd")
AWAY = os.path.expanduser("~/.voicemode/away")
DICT = os.path.expanduser("~/.voicemode/dictating")
QUEUE = ("Do not use voice. Queue it instead by running: ~/.voicemode/bin/inbox add "
         "'<your session name>' '<1-2 spoken-style sentences>' — it is read out when the user is back. "
         "Then carry on in text")
AGENTS = {
    "dnd": "Do-not-disturb is on (the user is asleep). " + QUEUE,
    "away": "The user is away from the keyboard. " + QUEUE,
    "dictating": ("The user is speaking into the microphone right now (dictating or on a call). "
                  "Do not talk over them: retry in about 20 seconds with wait_for_conch=true, "
                  "or queue it with ~/.voicemode/bin/inbox add '<your session name>' '<message>'"),
}
mode = None
conch = None
last_stamp = 0.0


def log(msg):
    print(f"{datetime.now():%Y-%m-%d %H:%M:%S} {msg}", flush=True)


def release(*_):
    global conch
    if conch is not None:
        try:
            conch.release(hold=False, spoke=False)
            log("released mic lock")
        except Exception as e:  # noqa: BLE001
            log(f"release failed: {e}")
        conch = None


def stop(*_):
    release()
    sys.exit(0)


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
log("dnd-guard started")

while True:
    want = ("dnd" if os.path.exists(DND) else "away" if os.path.exists(AWAY)
            else "dictating" if os.path.exists(DICT) else None)
    dnd = want is not None
    if dnd and conch is not None and want != mode:
        conch.agent_name, mode, last_stamp = AGENTS[want], want, 0  # re-stamp below with new text
        log(f"{want} now: updated lock message")
    if dnd and conch is None:
        c = Conch(agent_name=AGENTS[want], project_path=os.path.expanduser("~"))
        if c.try_acquire(agent_name=AGENTS[want]):
            conch, last_stamp, mode = c, time.time(), want
            log(f"{want} on: holding mic lock")
        # else: a session is mid-turn; try again shortly
    elif dnd and conch is not None and time.time() - last_stamp > 30:
        # re-stamp so VoiceMode never treats our lock as stale (300 s rule)
        try:
            conch._acquire_time = datetime.now()
            conch._write_locked_payload(held=False)
            last_stamp = time.time()
        except Exception as e:  # noqa: BLE001
            log(f"re-stamp failed, re-acquiring: {e}")
            release()
    elif not dnd and conch is not None:
        release()
        mode = None
        log("present again")
    time.sleep(1)
PY
